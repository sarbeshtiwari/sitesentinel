# Local development — matches infra/compose/docker-compose.dev.yml
# Copy to .env and adjust. Never commit .env. No production domain is hard-coded
# anywhere in the code: every public URL below is per-environment configuration.

# Deployment region label (initial deployment: Mumbai). Code paths are region-independent.
REGION=ap-south-1

# Public URLs (production: https://app.<domain>, https://admin.<domain>, …)
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000
SDK_URL=http://localhost:4200/sdk
# SDK telemetry endpoint (apps/ingest). Production: https://ingest.<domain>
INGEST_URL=http://localhost:4200
INGEST_PORT=4200
COOKIE_SECURE=false
TRUST_PROXY=false

# Schema owner (migrations only)
MIGRATION_DATABASE_URL=postgresql://wim_owner:wim_owner_dev_password@127.0.0.1:55432/wim
# Runtime roles (RLS-bound; see packages/db/sql/050_grants.sql)
DATABASE_URL=postgresql://wim_app:wim_app_dev_password@127.0.0.1:55432/wim
WORKER_DATABASE_URL=postgresql://wim_worker:wim_worker_dev_password@127.0.0.1:55432/wim
# worker-browser only: least-privilege role (release readiness, blocker 3)
BROWSER_DATABASE_URL=postgresql://wim_browser:wim_browser_dev_password@127.0.0.1:55432/wim
ADMIN_DATABASE_URL=postgresql://wim_admin:wim_admin_dev_password@127.0.0.1:55432/wim
# SDK ingest: function-only role (no table privileges)
INGEST_DATABASE_URL=postgresql://wim_ingest:wim_ingest_dev_password@127.0.0.1:55432/wim
SETTINGS_DATABASE_URL=postgresql://wim_app:wim_app_dev_password@127.0.0.1:55432/wim

REDIS_URL=redis://:wim_redis_dev_password@127.0.0.1:56379
QUEUE_PREFIX=wim

# Key ring (KEKs + HMAC pepper) lives OUTSIDE the database. Create the dev ring with
# `pnpm keys:init` (writes .keys/kek.json, git-ignored). Production: mount from a secret
# manager (or KEK_RING_JSON from the orchestrator's secret store); a KMS provider is Phase 10.
KEK_RING_FILE=.keys/kek.json

# Email: provider-independent (packages/email). smtp (Mailpit in dev) | resend | ses
EMAIL_PROVIDER=smtp
EMAIL_FROM_DOMAIN=localhost
EMAIL_FROM_LOCAL_PART=no-reply
SMTP_HOST=127.0.0.1
SMTP_PORT=51025
# RESEND_API_KEY=
# AWS_REGION=ap-south-1
# SES_CONFIGURATION_SET=

S3_ENDPOINT=http://127.0.0.1:58333
S3_ACCESS_KEY=wim_s3_dev
S3_SECRET_KEY=wim_s3_dev_password
S3_BUCKET_ARTIFACTS=wim-artifacts

# Resolvers used by the verification worker for ALL lookups (DNS TXT, A/AAAA for HTTP checks)
DNS_RESOLVERS=1.1.1.1,8.8.8.8
SCANNER_DATABASE_URL=postgresql://wim_scanner:wim_scanner_dev_password@127.0.0.1:55432/wim
