# SiteSentinel — Oracle single-server environment (template).
#
# On the server this file is CREATED by infra/oracle/setup.sh as /opt/sitesentinel/.env (owner root, mode 600) with
# every secret below generated randomly (openssl rand). You then only fill in the TODO lines (S3, email, operator email).
# Never commit the filled-in file, never paste it into chat or tickets. Rotate a value by editing it and re-running
# infra/oracle/deploy.sh (role passwords are re-applied by the `migrate` service on every deploy).
#
# Compose reads this file only for ${VAR} interpolation; each container receives just the variables it needs
# (see infra/oracle/docker-compose.prod.yml).

# ---------------------------------------------------------------- deployment
# Directory holding certs/, pg-tls/, backups/ and this .env on the server.
SITESENTINEL_DIR=/opt/sitesentinel
# Image tag used for the locally built images (deploy.sh sets it to the deployed git commit).
IMAGE_TAG=latest
# Region label shown in logs/metrics (Oracle region of the VM, e.g. ap-hyderabad-1 or ap-mumbai-1).
REGION=ap-hyderabad-1
LOG_LEVEL=info
QUEUE_PREFIX=wim
# Published ports of nginx (the only published ports). Keep 0.0.0.0:80/443 on the server; the host firewall only
# admits Cloudflare's ranges to them.
HTTP_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_BIND=0.0.0.0
HTTPS_PORT=443

# ---------------------------------------------------------------- public URLs (Cloudflare-proxied hostnames)
# Customer app (also the origin the API's CSRF/Origin check accepts for customer requests).
APP_URL=https://sentinel-client.ziptat.in
# Super Admin app (Origin check for admin requests).
ADMIN_URL=https://sentinel-admin.ziptat.in
# Public API base: screenshot download links and payment-gateway webhooks. Browsers call the API through
# /api on their own origin (same-origin cookies), so no CORS configuration exists or is needed.
API_URL=https://sentinel-api.ziptat.in
# Ingest origin (SDK telemetry + heartbeats) and the SDK script location. Same origin, so the install snippet has
# no data-endpoint attribute. The installation check looks for exactly this script URL on customer pages.
INGEST_URL=https://sentinel-ingest.ziptat.in
SDK_URL=https://sentinel-ingest.ziptat.in/sdk
# Cookies: host-only "__Host-" cookies on sentinel-client / sentinel-admin (no Domain attribute, Secure, Path=/).
# Nothing to configure — COOKIE_SECURE=true is fixed in the compose file (the API refuses to boot without it).

# ---------------------------------------------------------------- PostgreSQL (generated by setup.sh)
# All URLs are assembled in the compose file: postgresql://<role>:<password>@postgres:5432/wim
#   ?sslmode=verify-full&sslrootcert=/etc/sitesentinel/pg-ca.crt
# TLS is mandatory (pg_hba rejects non-TLS); the internal CA + server cert (CN/SAN "postgres") are generated by
# setup.sh into $SITESENTINEL_DIR/pg-tls. Passwords are hex (URL-safe). Each service has its own least-privilege role.
# Bootstrap superuser `postgres`: only the migrate service (role bootstrap) and `docker exec` use it.
PG_SUPERUSER_PASSWORD=GENERATED_BY_SETUP
# wim_owner: owns the schema; migrations, SQL, seed, backups, restore. NOT a superuser.
PG_OWNER_PASSWORD=GENERATED_BY_SETUP
# wim_app: api (customer API) + ingest (settings reads).
PG_APP_PASSWORD=GENERATED_BY_SETUP
# wim_admin: api (admin module, views only).
PG_ADMIN_PASSWORD=GENERATED_BY_SETUP
# wim_worker: scheduler, worker-http, worker-notify.
PG_WORKER_PASSWORD=GENERATED_BY_SETUP
# wim_browser: worker-browser (narrow role; the broad worker role is refused in production).
PG_BROWSER_PASSWORD=GENERATED_BY_SETUP
# wim_scanner: worker-deepscan (narrow role).
PG_SCANNER_PASSWORD=GENERATED_BY_SETUP
# wim_ingest: ingest (executes ingest_* functions only, no table privileges).
PG_INGEST_PASSWORD=GENERATED_BY_SETUP
# wim_readonly: BI / support read access (no service uses it; for psql sessions over an SSH tunnel).
PG_READONLY_PASSWORD=GENERATED_BY_SETUP

# ---------------------------------------------------------------- Redis (generated by setup.sh)
# redis://:<password>@redis:6379 (internal data network only; not published). AOF on, noeviction.
REDIS_PASSWORD=GENERATED_BY_SETUP

# ---------------------------------------------------------------- application secrets (generated by setup.sh)
# Shared by egress-gateway, worker-http, worker-deepscan and worker-browser: signs per-job egress capability tokens.
# 64 hex characters (≥ 32 required).
EGRESS_TOKEN_SECRET=GENERATED_BY_SETUP
# Key ring for envelope encryption (packages/crypto LocalKeyProvider.fromEnv): base64 of the JSON
#   {"current":"oracle-1","keys":{"oracle-1":"<base64 of 32 random bytes>"},"hmacPepper":"<base64 of 32 random bytes>"}
# api only. MIGRATING FROM RENDER: you MUST reuse Render's KEK_RING_JSON value here (copy it from the Render API
# service's environment yourself) — data encrypted under the old ring (2FA secrets, channel configs, gateway secrets)
# cannot be decrypted with a new one. A fresh install keeps the generated value.
KEK_RING_JSON=GENERATED_BY_SETUP
# Passphrase for the encrypted daily database backups (backup.sh / restore.sh, gpg AES-256). Store a copy in your
# password manager: without it the backups are unreadable.
BACKUP_PASSPHRASE=GENERATED_BY_SETUP
# (No session/CSRF secrets exist: sessions are random tokens stored hashed in PostgreSQL; CSRF is double-submit +
#  Origin checks. HMAC keys derive from KEK_RING_JSON's hmacPepper.)

# ---------------------------------------------------------------- object storage (TODO: fill in)
# Screenshots/artifacts stay on the existing AWS S3 bucket. Use an IAM user limited to this bucket
# (s3:GetObject, s3:PutObject, s3:DeleteObject, s3:ListBucket, s3:GetBucketLocation). api + worker-browser.
# Without these values browser checks still run; screenshots are skipped.
S3_ENDPOINT=https://s3.eu-north-1.amazonaws.com
S3_ACCESS_KEY=TODO
S3_SECRET_KEY=TODO
S3_BUCKET_ARTIFACTS=TODO-existing-bucket-name

# ---------------------------------------------------------------- database backups to S3 (TODO: fill in)
# backup.sh uploads encrypted dumps to s3://$BACKUP_S3_BUCKET/$BACKUP_S3_PREFIX/ and keeps the newest 14.
# A separate IAM key limited to this bucket/prefix is recommended (s3:PutObject, s3:GetObject, s3:ListBucket,
# s3:DeleteObject). May be the artifact bucket with a different prefix.
BACKUP_S3_BUCKET=TODO-backup-bucket-name
BACKUP_S3_PREFIX=sitesentinel/db
BACKUP_S3_REGION=eu-north-1
BACKUP_AWS_ACCESS_KEY_ID=TODO
BACKUP_AWS_SECRET_ACCESS_KEY=TODO
BACKUP_KEEP=14

# ---------------------------------------------------------------- email (TODO: fill in; in-app notifications work without)
# Sender: <EMAIL_FROM_LOCAL_PART>@<EMAIL_FROM_DOMAIN>; SPF/DKIM/DMARC of the domain must cover the provider.
EMAIL_FROM_DOMAIN=ziptat.in
EMAIL_FROM_LOCAL_PART=no-reply
# resend | smtp | ses
EMAIL_PROVIDER=resend
RESEND_API_KEY=TODO
# smtp only
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# ses only (credentials via the AWS SDK default chain are not available in the container; prefer resend/smtp)
SES_REGION=ap-south-1
SES_CONFIGURATION_SET=
# REQUIRED in production: operator addresses alerted directly while PostgreSQL is unreachable (comma-separated).
OPS_FALLBACK_ALERT_EMAILS=TODO-you@example.com

# ---------------------------------------------------------------- monitoring tuning (optional)
# Resolvers used by the egress gateway for every customer lookup.
DNS_RESOLVERS=1.1.1.1,8.8.8.8
# Parallel Chromium sessions in browser-runner and its memory limit (1g fits 2 sessions).
RUNNER_MAX_SESSIONS=2
RUNNER_MEM_LIMIT=1g
