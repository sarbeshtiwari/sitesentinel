/// One active incident per fingerprint — partial unique (sql/030):
///   UNIQUE (org_id, fingerprint) WHERE status IN ('OPEN','ACKNOWLEDGED','INVESTIGATING','REOPENED')
model Incident {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number           Int // per-org human id: INC-1042
  orgId            String           @map("org_id") @db.Uuid
  websiteId        String           @map("website_id") @db.Uuid
  monitoredPageId  String?          @map("monitored_page_id") @db.Uuid
  apiEndpointId    String?          @map("api_endpoint_id") @db.Uuid
  fingerprint      String
  checkKey         String           @map("check_key")
  category         IncidentCategory
  source           SignalSource
  severity         Severity
  status           IncidentStatus   @default(OPEN)
  title            String
  description      String
  scope            String // page template / endpoint / site
  diagnostics      Json // redacted summary; full detail in occurrences
  occurrenceCount  Int              @default(1) @map("occurrence_count")
  firstDetectedAt  DateTime         @map("first_detected_at") @db.Timestamptz(6)
  lastDetectedAt   DateTime         @map("last_detected_at") @db.Timestamptz(6)
  acknowledgedAt   DateTime?        @map("acknowledged_at") @db.Timestamptz(6)
  acknowledgedById String?          @map("acknowledged_by_id") @db.Uuid
  resolvedAt       DateTime?        @map("resolved_at") @db.Timestamptz(6)
  resolvedById     String?          @map("resolved_by_id") @db.Uuid
  autoResolved     Boolean          @default(false) @map("auto_resolved")
  reopenCount      Int              @default(0) @map("reopen_count")
  flapping         Boolean          @default(false)
  inMaintenance    Boolean          @default(false) @map("in_maintenance")
  ignoredUntil     DateTime?        @map("ignored_until") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  website      Website           @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  events       IncidentEvent[]
  comments     IncidentComment[]

  @@unique([orgId, number])
  @@index([orgId, status, severity])
  @@index([orgId, fingerprint, resolvedAt])
  @@index([websiteId, firstDetectedAt(sort: Desc)])
  @@index([orgId, lastDetectedAt(sort: Desc), id]) // Phase 4F: incident list + keyset cursor
  @@map("incidents")
}

