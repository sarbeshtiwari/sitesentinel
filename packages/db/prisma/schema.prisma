// ----------------------------------------------------------------------------
// Identity & access
// ----------------------------------------------------------------------------

model User {
  id                   String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                String     @db.Citext
  emailVerifiedAt      DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  passwordHash         String     @map("password_hash") // argon2id encoded string
  name                 String?
  timezone             String     @default("UTC")
  locale               String     @default("en")
  status               UserStatus @default(ACTIVE)
  totpSecretEnc        Bytes?     @map("totp_secret_enc")
  totpEnabledAt        DateTime?  @map("totp_enabled_at") @db.Timestamptz(6)
  totpPendingSecretEnc Bytes?     @map("totp_pending_secret_enc") // enrollment in progress, not yet confirmed
  totpLastUsedStep     BigInt?    @map("totp_last_used_step") // replay protection (RFC 6238 §5.2)
  failedLoginCount     Int        @default(0) @map("failed_login_count")
  lockedUntil          DateTime?  @map("locked_until") @db.Timestamptz(6)
  lastLoginAt          DateTime?  @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt    DateTime?  @map("password_changed_at") @db.Timestamptz(6)
  deletionRequestedAt  DateTime?  @map("deletion_requested_at") @db.Timestamptz(6)
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions          UserSession[]
  recoveryCodes     RecoveryCode[]
  recoveryRequests  AccountRecoveryRequest[]
  memberships       OrganizationMember[]
  emailTokens       EmailVerificationToken[]
  passwordResets    PasswordResetToken[]
  notificationPrefs NotificationPreference[]
  notifications     Notification[]

  @@unique([email])
  @@map("users")
}

model UserSession {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") // sha256(opaque token)
  csrfSecret  String    @map("csrf_secret")
  ipPrefix    String?   @map("ip_prefix") // /24 or /48 only
  userAgent   String?   @map("user_agent")
  mfaVerified Boolean   @default(false) @map("mfa_verified")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

model RecoveryCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

model EmailVerificationToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  email     String    @db.Citext // address being verified (supports email change)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

/// Login attempts (success + failure) for customers and admins. Partitioned monthly. [PARTITIONED]
model LoginAttempt {
  id         String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurredAt DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorType  ActorType @map("actor_type")
  userId     String?   @map("user_id") @db.Uuid
  emailHash  String    @map("email_hash") // HMAC — attempts for unknown emails are still tracked
  ipPrefix   String?   @map("ip_prefix")
  success    Boolean
  reason     String? // BAD_PASSWORD | LOCKED | MFA_FAILED | RATE_LIMITED | ...

  @@id([id, occurredAt])
  @@index([emailHash, occurredAt])
  @@index([userId, occurredAt])
  @@map("login_attempts")
}

model AdminUser {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String    @unique @db.Citext
  name             String
  passwordHash     String    @map("password_hash")
  role             AdminRole
  totpSecretEnc    Bytes     @map("totp_secret_enc") // 2FA mandatory for admins
  totpLastUsedStep BigInt?   @map("totp_last_used_step")
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz(6)
  webauthn         Json? // registered credentials (public keys only)
  active           Boolean   @default(true)
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdById      String?   @map("created_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions AdminSession[]

  @@map("admin_users")
}

model AdminSession {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminUserId String    @map("admin_user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  csrfSecret  String    @map("csrf_secret")
  ipPrefix    String?   @map("ip_prefix")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6) // short: 8h absolute, 30m idle
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@map("admin_sessions")
}

// ----------------------------------------------------------------------------
// Organizations, roles, permissions
// ----------------------------------------------------------------------------

model Organization {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String
  slug                String    @unique
  status              OrgStatus @default(ACTIVE)
  timezone            String    @default("UTC")
  currency            String    @default("USD") @db.Char(3)
  supportAccess       String    @default("REQUIRE_CUSTOMER_CONSENT") @map("support_access") // break-glass policy
  suspendedReason     String?   @map("suspended_reason")
  deletionRequestedAt DateTime? @map("deletion_requested_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  members              OrganizationMember[]
  invitations          Invitation[]
  roles                Role[]
  encryptionKeys       OrgEncryptionKey[]
  websites             Website[]
  domainClaims         DomainClaim[]
  subscriptions        Subscription[]
  trials               Trial[]
  entitlementOverrides EntitlementOverride[]
  incidents            Incident[]
  notificationChannels NotificationChannel[]
  gatewayCustomers     GatewayCustomer[]
  usageCounters        UsageCounter[]
  invoices             Invoice[]
  payments             Payment[]
  reportJobs           ReportJob[]

  @@map("organizations")
}

/// System roles have org_id NULL (OWNER, ADMIN, MEMBER, VIEWER). Custom roles are per org.
model Role {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String? @map("org_id") @db.Uuid
  key         String
  name        String
  description String?
  isSystem    Boolean @default(false) @map("is_system")

  organization Organization?        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  members      OrganizationMember[]

  @@unique([orgId, key]) // + partial unique on key WHERE org_id IS NULL (sql/030)
  @@map("roles")
}

model Permission {
  key         String @id // e.g. "website:create", "incident:acknowledge", "billing:manage"
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

model OrganizationMember {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([orgId, userId])
  @@index([userId])
  @@map("organization_members")
}

model Invitation {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String           @map("org_id") @db.Uuid
  email        String           @db.Citext
  roleId       String           @map("role_id") @db.Uuid
  tokenHash    String           @unique @map("token_hash")
  status       InvitationStatus @default(PENDING)
  invitedById  String           @map("invited_by_id") @db.Uuid
  expiresAt    DateTime         @map("expires_at") @db.Timestamptz(6)
  acceptedAt   DateTime?        @map("accepted_at") @db.Timestamptz(6)
  acceptedById String?          @map("accepted_by_id") @db.Uuid
  lastSentAt   DateTime?        @map("last_sent_at") @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
  @@index([orgId, email, status])
  @@map("invitations")
}

/// Lost-second-factor recovery (SECURITY.md §7.5): email confirmation, then a waiting
/// period with notification and cancellation, then the factor is removed at next login.
model AccountRecoveryRequest {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  kind             String    @default("MFA_RESET")
  status           String    @default("PENDING_EMAIL") // PENDING_EMAIL | WAITING | COMPLETED | CANCELLED | EXPIRED
  confirmTokenHash String?   @unique @map("confirm_token_hash")
  cancelTokenHash  String?   @unique @map("cancel_token_hash")
  confirmExpiresAt DateTime  @map("confirm_expires_at") @db.Timestamptz(6)
  eligibleAt       DateTime? @map("eligible_at") @db.Timestamptz(6)
  ipPrefix         String?   @map("ip_prefix")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  confirmedAt      DateTime? @map("confirmed_at") @db.Timestamptz(6)
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(6)
  cancelledAt      DateTime? @map("cancelled_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("account_recovery_requests")
}

/// Platform-scoped data keys (user TOTP secrets, admin secrets, platform config secrets).
/// Wrapped by a KEK held outside the database (KeyProvider); unusable without it.
model PlatformDataKey {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purpose    String // "user-secrets" | "admin-secrets" | "platform-config"
  version    Int
  kekId      String    @map("kek_id")
  wrappedDek Bytes     @map("wrapped_dek")
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  retiredAt  DateTime? @map("retired_at") @db.Timestamptz(6)

  @@unique([purpose, version])
  @@map("platform_data_keys")
}

/// Envelope encryption: per-org data key wrapped by the KEK. Destroying rows = crypto-shredding.
model OrgEncryptionKey {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId      String    @map("org_id") @db.Uuid
  version    Int
  kekId      String    @map("kek_id") // KeyProvider key reference + version
  wrappedDek Bytes     @map("wrapped_dek")
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  retiredAt  DateTime? @map("retired_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, version])
  @@map("org_encryption_keys")
}

// ----------------------------------------------------------------------------
// Domain identity, registry, verification, transfers, anti-abuse
// ----------------------------------------------------------------------------

/// One row per normalized identity, permanent. Never deleted on account deletion.
model DomainRegistry {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identityKey       String    @unique @map("identity_key") // e.g. "example.co.uk" or "shop.example.co.uk"
  hostKey           String    @map("host_key") // punycode host, alias labels stripped
  registrableDomain String    @map("registrable_domain") // PSL eTLD+1
  displayHost       String    @map("display_host") // unicode form for UI
  isRoot            Boolean   @map("is_root") // hostKey == registrableDomain
  firstSeenAt       DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  firstVerifiedAt   DateTime? @map("first_verified_at") @db.Timestamptz(6)
  blocked           Boolean   @default(false)

  claims    DomainClaim[]
  transfers DomainTransfer[]
  attempts  DomainRegistrationAttempt[]

  @@index([registrableDomain])
  @@map("domain_registry")
}

/// An org's claim on an identity. Partial unique index (sql/030):
///   UNIQUE (domain_registry_id) WHERE status IN ('PENDING','VERIFIED','LAPSED')
model DomainClaim {
  id                      String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  domainRegistryId        String              @map("domain_registry_id") @db.Uuid
  orgId                   String?             @map("org_id") @db.Uuid // NULL after org deletion (history retained)
  scope                   ClaimScope
  status                  ClaimStatus         @default(PENDING)
  policy                  DomainPolicy
  verificationToken       String              @map("verification_token") // random, non-secret proof value
  tokenIssuedAt           DateTime            @default(now()) @map("token_issued_at") @db.Timestamptz(6)
  verificationAttempts    Int                 @default(0) @map("verification_attempts") // since the current token was issued
  lastAttemptAt           DateTime?           @map("last_attempt_at") @db.Timestamptz(6)
  verifiedMethod          VerificationMethod? @map("verified_method")
  inheritedFromClaimId    String?             @map("inherited_from_claim_id") @db.Uuid // verified via the org's ROOT claim
  // ---- periodic ownership revalidation (Phase 4A)
  nextRevalidationAt      DateTime?           @map("next_revalidation_at") @db.Timestamptz(6)
  revalidationState       String              @default("OK") @map("revalidation_state") // OK | FAILING | LAPSED
  lastRevalidationAt      DateTime?           @map("last_revalidation_at") @db.Timestamptz(6)
  lastRevalidationOutcome String?             @map("last_revalidation_outcome") // SUCCEEDED | TEMPORARY_FAILURE | DEFINITIVE_FAILURE | SERVICE_UNAVAILABLE
  revalidationFailures    Int                 @default(0) @map("revalidation_failures") // consecutive definitive failures
  transientFailures       Int                 @default(0) @map("transient_failures") // consecutive temporary failures (not counted towards lapse)
  failingSince            DateTime?           @map("failing_since") @db.Timestamptz(6)
  pendingExpiresAt        DateTime?           @map("pending_expires_at") @db.Timestamptz(6)
  verifiedAt              DateTime?           @map("verified_at") @db.Timestamptz(6)
  lastReverifiedAt        DateTime?           @map("last_reverified_at") @db.Timestamptz(6)
  lapsedAt                DateTime?           @map("lapsed_at") @db.Timestamptz(6)
  releasedAt              DateTime?           @map("released_at") @db.Timestamptz(6)
  releaseReason           String?             @map("release_reason") // ORG_DELETED | EXPIRED | TRANSFER | ADMIN | LAPSED
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  domainRegistry DomainRegistry       @relation(fields: [domainRegistryId], references: [id], onDelete: Restrict)
  organization   Organization?        @relation(fields: [orgId], references: [id], onDelete: SetNull)
  verifications  DomainVerification[]
  website        Website?

  @@index([orgId, status])
  @@index([status, pendingExpiresAt])
  @@index([status, nextRevalidationAt])
  @@map("domain_claims")
}

model DomainVerification {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId            String?            @map("org_id") @db.Uuid // tenant RLS (020 loop); NULL only for historical rows
  domainClaimId    String             @map("domain_claim_id") @db.Uuid
  scopeGranted     ClaimScope?        @map("scope_granted")
  method           VerificationMethod
  status           VerificationStatus @default(PENDING)
  detail           Json? // resolver answers / fetched status — never page content
  failureReason    String?            @map("failure_reason")
  requestedAt      DateTime           @default(now()) @map("requested_at") @db.Timestamptz(6)
  completedAt      DateTime?          @map("completed_at") @db.Timestamptz(6)
  isReverification Boolean            @default(false) @map("is_reverification")

  domainClaim DomainClaim @relation(fields: [domainClaimId], references: [id], onDelete: Cascade)

  @@index([domainClaimId, requestedAt])
  @@map("domain_verifications")
}

/// Every registration attempt including rejected duplicates — admin review & abuse analysis.
/// This is the `domain_registration_history` entity from the spec.
model DomainRegistrationAttempt {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  domainRegistryId String?  @map("domain_registry_id") @db.Uuid
  orgId            String?  @map("org_id") @db.Uuid
  inputHost        String   @map("input_host") // normalized input host only
  outcome          String // ACCEPTED | DUPLICATE | DUPLICATE_NAMESPACE | DUPLICATE_OWN | BLOCKED | INVALID | LIMIT | TRANSFER_REQUESTED
  reason           String?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  domainRegistry DomainRegistry? @relation(fields: [domainRegistryId], references: [id], onDelete: SetNull)

  @@index([domainRegistryId, createdAt])
  @@index([outcome, createdAt])
  @@map("domain_registration_attempts")
}

model DomainTransfer {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  domainRegistryId     String         @map("domain_registry_id") @db.Uuid
  fromClaimId          String?        @map("from_claim_id") @db.Uuid
  fromOrgId            String?        @map("from_org_id") @db.Uuid // current owner at request time (never shown to the requester)
  toOrgId              String?        @map("to_org_id") @db.Uuid
  requestedById        String?        @map("requested_by_id") @db.Uuid
  verificationToken    String?        @map("verification_token") // requester's DNS proof value
  tokenExpiresAt       DateTime?      @map("token_expires_at") @db.Timestamptz(6)
  verificationAttempts Int            @default(0) @map("verification_attempts")
  verifiedAt           DateTime?      @map("verified_at") @db.Timestamptz(6)
  lastCheckDetail      Json?          @map("last_check_detail")
  appliedAt            DateTime?      @map("applied_at") @db.Timestamptz(6)
  toWebsiteId          String?        @map("to_website_id") @db.Uuid
  toClaimId            String?        @map("to_claim_id") @db.Uuid // the requester's DNS-verified claim
  status               TransferStatus @default(PENDING_VERIFICATION)
  ownerResponse        String?        @map("owner_response") // NONE | CONTESTED | ACCEPTED
  ownerRespondBy       DateTime?      @map("owner_respond_by") @db.Timestamptz(6)
  decidedByAdminId     String?        @map("decided_by_admin_id") @db.Uuid
  decisionReason       String?        @map("decision_reason")
  autoApproved         Boolean        @default(false) @map("auto_approved")
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  decidedAt            DateTime?      @map("decided_at") @db.Timestamptz(6)

  domainRegistry DomainRegistry @relation(fields: [domainRegistryId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@map("domain_transfers")
}

/// Permanent, minimal trial ledger keyed by registrable domain. No personal data, no org id.
model DomainTrialLedger {
  registrableDomain String    @id @map("registrable_domain")
  firstRegisteredAt DateTime  @default(now()) @map("first_registered_at") @db.Timestamptz(6)
  firstVerifiedAt   DateTime? @map("first_verified_at") @db.Timestamptz(6)
  trialConsumedAt   DateTime? @map("trial_consumed_at") @db.Timestamptz(6)
  trialCount        Int       @default(0) @map("trial_count")
  registrationCount Int       @default(0) @map("registration_count")
  lastReleasedAt    DateTime? @map("last_released_at") @db.Timestamptz(6)
  flags             String[]  @default([])
  adminResetAt      DateTime? @map("admin_reset_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("domain_trial_ledger")
}

/// Keyed-HMAC secondary anti-abuse signals. Unlinkable to an identity without the pepper.
model AbuseSignal {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind        String // EMAIL | CARD_FINGERPRINT | IP_PREFIX
  valueHash   String    @map("value_hash")
  trialUsedAt DateTime? @map("trial_used_at") @db.Timestamptz(6)
  seenCount   Int       @default(1) @map("seen_count")
  firstSeenAt DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)

  @@unique([kind, valueHash])
  @@index([expiresAt])
  @@map("abuse_signals")
}

model BlockedDomain {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pattern     String   @unique // registrable domain or host; exact match
  reason      String
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("blocked_domains")
}

/// Admin-added suffixes treated as public (in addition to the PSL).
model DomainPolicySuffix {
  suffix    String   @id
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("domain_policy_suffixes")
}

/// Hosts approved for API monitoring beyond verified websites.
model ApiHostAuthorization {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId             String?           @map("org_id") @db.Uuid // NULL = platform-wide allowlist entry
  host              String
  kind              HostAuthorization
  verificationToken String?           @map("verification_token")
  verifiedAt        DateTime?         @map("verified_at") @db.Timestamptz(6)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([orgId, host])
  @@map("api_host_authorizations")
}

// ----------------------------------------------------------------------------
// Websites, installation, configuration
// ----------------------------------------------------------------------------

model Website {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId              String        @map("org_id") @db.Uuid
  domainClaimId      String        @unique @map("domain_claim_id") @db.Uuid
  name               String
  description        String?
  category           String        @default("OTHER")
  monitoringTimezone String        @default("UTC") @map("monitoring_timezone")
  canonicalOrigin    String        @map("canonical_origin") // https://www.example.com
  verifiedAt         DateTime?     @map("verified_at") @db.Timestamptz(6)
  trialOutcome       String?       @map("trial_outcome") // decideTrial() outcome at first verification
  status             WebsiteStatus @default(PENDING_VERIFICATION)
  pausedAt           DateTime?     @map("paused_at") @db.Timestamptz(6)
  suspendedReason    String?       @map("suspended_reason")
  healthScore        Int?          @map("health_score") // latest, denormalized
  healthBand         String?       @map("health_band")
  lastCheckedAt      DateTime?     @map("last_checked_at") @db.Timestamptz(6)
  currentState       String        @default("UNKNOWN") @map("current_state") // UP | DOWN | DEGRADED | UNKNOWN
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt         DateTime?     @map("archived_at") @db.Timestamptz(6)

  organization       Organization             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  domainClaim        DomainClaim              @relation(fields: [domainClaimId], references: [id], onDelete: Restrict)
  installation       SiteInstallation?
  config             MonitoringConfiguration?
  maintenanceWindows MaintenanceWindow[]
  authRecipes        AuthRecipe[]
  discoveredPages    DiscoveredPage[]
  monitoredPages     MonitoredPage[]
  testCases          TestCase[]
  apiEndpoints       ApiEndpoint[]
  schedules          MonitoringSchedule[]
  incidents          Incident[]
  incidentRules      IncidentRule[]

  @@index([orgId, status])
  @@map("websites")
}

model SiteInstallation {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                String             @map("org_id") @db.Uuid
  websiteId            String             @unique @map("website_id") @db.Uuid
  siteKey              String             @unique @map("site_key") // public "pk_live_…", ingest-only
  previousSiteKey      String?            @map("previous_site_key") // accepted during rotation grace
  previousKeyExpiresAt DateTime?          @map("previous_key_expires_at") @db.Timestamptz(6)
  status               InstallationStatus @default(NOT_DETECTED) // legacy; state is derived (core installationState)
  keyCreatedAt         DateTime           @default(now()) @map("key_created_at") @db.Timestamptz(6)
  revokedAt            DateTime?          @map("revoked_at") @db.Timestamptz(6) // current key revoked (no key accepted)
  telemetryPaused      Boolean            @default(false) @map("telemetry_paused")
  sdkVersion           String?            @map("sdk_version")
  firstSeenAt          DateTime?          @map("first_seen_at") @db.Timestamptz(6) // first VALID heartbeat
  lastSeenAt           DateTime?          @map("last_seen_at") @db.Timestamptz(6) // last VALID heartbeat
  heartbeatCount       Int                @default(0) @map("heartbeat_count") // distinct page loads (deduplicated)
  lastInvalidAt        DateTime?          @map("last_invalid_at") @db.Timestamptz(6)
  lastInvalidReason    String?            @map("last_invalid_reason") // ORIGIN_MISMATCH | REVOKED_KEY | WEBSITE_NOT_VERIFIED | EXPIRED_KEY
  lastInvalidOrigin    String?            @map("last_invalid_origin")
  lastCheck            Json?              @map("last_check") // server-side installation check result
  lastCheckedAt        DateTime?          @map("last_checked_at") @db.Timestamptz(6)
  sdkConfig            Json               @default("{}") @map("sdk_config") // sampling, capture flags, masking rules
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@map("site_installations")
}

/// Per-website monitoring settings. Validated against resolved entitlements on every write.
model MonitoringConfiguration {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                 String   @map("org_id") @db.Uuid
  websiteId             String   @unique @map("website_id") @db.Uuid
  t1IntervalSec         Int?     @map("t1_interval_sec") // customer-requested slower interval; NULL = entitled default (Phase 4C fix)
  t2IntervalSec         Int?     @map("t2_interval_sec") // customer-requested slower interval; NULL = entitled default
  t3IntervalSec         Int?     @map("t3_interval_sec") // customer-requested slower interval; NULL = entitled default
  t1Urls                String[] @default([]) @map("t1_urls") // extra key URLs probed at T1
  viewports             Json     @default("[{\"name\":\"desktop\",\"width\":1366,\"height\":768}]")
  maxPages              Int?     @map("max_pages") // customer cap; NULL = plan limit (Phase 4E: default 25 removed)
  maxDepth              Int?     @map("max_depth") // customer cap; NULL = plan limit (Phase 4E: default 3 removed)
  includePatterns       String[] @default([]) @map("include_patterns")
  excludePatterns       String[] @default([]) @map("exclude_patterns")
  queryParamMode        String   @default("KEEP_MEANINGFUL") @map("query_param_mode") // KEEP_MEANINGFUL | IGNORE_ALL | ALLOWLIST (Phase 4E)
  queryParamAllowlist   String[] @default([]) @map("query_param_allowlist")
  respectRobots         Boolean  @default(true) @map("respect_robots")
  performanceThresholds Json     @default("{}") @map("performance_thresholds")
  componentSelectors    Json     @default("{}") @map("component_selectors") // customer overrides per type
  keywordChecks         Json     @default("[]") @map("keyword_checks")
  storeResponseSamples  Boolean  @default(false) @map("store_response_samples")
  httpCheck             Json?    @map("http_check") // Phase 4C HttpCheckConfig (validated in @wim/core)
  browserCheck          Json?    @map("browser_check") // Phase 4D BrowserCheckConfig (validated in @wim/core)
  deepScan              Json?    @map("deep_scan") // Phase 4E DeepScanConfig (validated in @wim/core)
  captureArtifactsOn    String   @default("FAILURE") @map("capture_artifacts_on") // NEVER | FAILURE | ALWAYS
  version               Int      @default(1)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById           String?  @map("updated_by_id") @db.Uuid

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@map("monitoring_configurations")
}

model MaintenanceWindow {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  websiteId   String?  @map("website_id") @db.Uuid // NULL = whole org
  name        String
  startsAt    DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt      DateTime @map("ends_at") @db.Timestamptz(6)
  rrule       String? // RFC 5545 recurrence
  timezone    String   @default("UTC")
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  website Website? @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([orgId, startsAt, endsAt])
  @@map("maintenance_windows")
}

/// Login recipe for monitoring authenticated areas. Secrets envelope-encrypted; decrypted only by browser workers.
model AuthRecipe {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String   @map("org_id") @db.Uuid
  websiteId       String   @map("website_id") @db.Uuid
  name            String
  loginUrl        String   @map("login_url")
  steps           Json // constrained step DSL; credential placeholders only
  credentialsEnc  Bytes    @map("credentials_enc")
  keyVersion      Int      @map("key_version")
  successSelector String   @map("success_selector")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@map("auth_recipes")
}

// ----------------------------------------------------------------------------
// Pages, components, test cases
// ----------------------------------------------------------------------------

model DiscoveredPage {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String     @map("org_id") @db.Uuid
  websiteId    String     @map("website_id") @db.Uuid
  url          String // canonicalized
  urlHash      String     @map("url_hash") // sha256(url) for unique index (urls can exceed btree limits)
  pathTemplate String     @map("path_template") // /product/{n}
  source       String // SITEMAP | ROBOTS | CRAWL | MANUAL | SDK
  depth        Int        @default(0)
  status       PageStatus @default(ACTIVE)
  title        String?
  contentHash  String?    @map("content_hash")
  firstSeenAt  DateTime   @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt   DateTime   @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  missedCrawls Int        @default(0) @map("missed_crawls")

  website   Website        @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  monitored MonitoredPage?

  @@unique([websiteId, urlHash])
  @@index([orgId, websiteId, status])
  @@map("discovered_pages")
}

model MonitoredPage {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId            String     @map("org_id") @db.Uuid
  websiteId        String     @map("website_id") @db.Uuid
  discoveredPageId String     @unique @map("discovered_page_id") @db.Uuid
  pinned           Boolean    @default(false) // customer-selected; kept first under limits
  t2Enabled        Boolean    @default(false) @map("t2_enabled")
  status           PageStatus @default(ACTIVE)
  currentState     String     @default("UNKNOWN") @map("current_state")
  lastResultAt     DateTime?  @map("last_result_at") @db.Timestamptz(6)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  website        Website         @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  discoveredPage DiscoveredPage  @relation(fields: [discoveredPageId], references: [id], onDelete: Cascade)
  components     PageComponent[]

  @@index([orgId, websiteId, status])
  @@map("monitored_pages")
}

/// Stable identity of a detected component across runs.
model PageComponent {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String        @map("org_id") @db.Uuid
  monitoredPageId String        @map("monitored_page_id") @db.Uuid
  type            ComponentType
  selector        String
  domPathHash     String        @map("dom_path_hash")
  confidence      Float
  evidence        Json // [{heuristic, detail}]
  confirmed       Boolean       @default(false) // customer-confirmed selector → confidence 1.0
  firstSeenAt     DateTime      @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt      DateTime      @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  // Phase 4F: inventory state and change detection (dom_path_hash = hash of the structural key)
  websiteId       String        @map("website_id") @db.Uuid
  status          String        @default("PRESENT") // PRESENT | REMOVED (after consecutive complete runs without it)
  label           String?
  detail          Json          @default("{}") // identity-relevant detail (links, fields, method, label…) — no page content
  detailHash      String        @default("") @map("detail_hash")
  viewports       String[]      @default([]) // viewports where it was visible in the last run
  visibility      Json          @default("{}") // Phase 4G: last known {viewport: visible} per OBSERVED viewport
  missedRuns      Int           @default(0) @map("missed_runs")
  lastExecutionId String?       @map("last_execution_id") @db.Uuid
  removedAt       DateTime?     @map("removed_at") @db.Timestamptz(6)

  monitoredPage MonitoredPage    @relation(fields: [monitoredPageId], references: [id], onDelete: Cascade)
  events        ComponentEvent[]

  @@unique([monitoredPageId, type, domPathHash])
  @@index([websiteId, status])
  @@map("page_components")
}

/// Phase 4F: component history — one row per meaningful change, per execution.
model ComponentEvent {
  id              BigInt   @id @default(autoincrement())
  orgId           String   @map("org_id") @db.Uuid
  websiteId       String   @map("website_id") @db.Uuid
  pageComponentId String   @map("page_component_id") @db.Uuid
  executionId     String   @map("execution_id") @db.Uuid
  type            String // ADDED | CHANGED | REMOVED | RESTORED | VISIBILITY (Phase 4G)
  before          Json?
  after           Json?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  component PageComponent @relation(fields: [pageComponentId], references: [id], onDelete: Cascade)

  @@unique([pageComponentId, executionId, type])
  @@index([websiteId, createdAt(sort: Desc)])
  @@map("component_events")
}

model TestCase {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String     @map("org_id") @db.Uuid
  websiteId    String     @map("website_id") @db.Uuid
  name         String
  kind         String // BUILTIN | CUSTOM | JOURNEY
  builtinKey   String?    @map("builtin_key")
  appliesTo    Json       @map("applies_to") // {componentType} | {selector, pageIds} | {journey: true}
  steps        Json // constrained step DSL (no arbitrary JS)
  assertions   Json
  safety       TestSafety @default(SAFE)
  stepsHash    String     @map("steps_hash")
  approvedById String?    @map("approved_by_id") @db.Uuid
  approvedAt   DateTime?  @map("approved_at") @db.Timestamptz(6)
  approvedHash String?    @map("approved_hash") // must equal steps_hash to run REQUIRES_APPROVAL
  allowedHosts String[]   @default([]) @map("allowed_hosts")
  authRecipeId String?    @map("auth_recipe_id") @db.Uuid
  enabled      Boolean    @default(true)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([orgId, websiteId])
  @@map("test_cases")
}

// ----------------------------------------------------------------------------
// Scheduling & execution ledger
// ----------------------------------------------------------------------------

/// One schedule per (website|api endpoint, tier). Claimed by the scheduler via FOR UPDATE SKIP LOCKED.
/// BullMQ jobs are the transport; this table + monitoring_executions are the durable ledger
/// (the spec's `monitoring_jobs` entity).
model MonitoringSchedule {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String         @map("org_id") @db.Uuid
  websiteId      String         @map("website_id") @db.Uuid
  apiEndpointId  String?        @map("api_endpoint_id") @db.Uuid
  tier           CheckTier
  intervalSec    Int            @map("interval_sec")
  jitterSec      Int            @map("jitter_sec")
  priority       Int            @default(5)
  region         String         @default("r1")
  status         ScheduleStatus @default(ACTIVE)
  nextRunAt      DateTime       @map("next_run_at") @db.Timestamptz(6)
  lastEnqueuedAt DateTime?      @map("last_enqueued_at") @db.Timestamptz(6)
  missedSlots    Int            @default(0) @map("missed_slots")
  state          Json? // Phase 4C: per-website monitor state (consecutive counters, open incident ids)
  stateWindowAt  DateTime?      @map("state_window_at") @db.Timestamptz(6) // newest window applied to `state`
  pausedReason   String?        @map("paused_reason") // WEBSITE_PAUSED | WEBSITE_INACTIVE | OWNERSHIP_LAPSED | ORG_SUSPENDED | NOT_ENTITLED | TIER_DISABLED | WEBSITE_LIMIT
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  website     Website      @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  apiEndpoint ApiEndpoint? @relation(fields: [apiEndpointId], references: [id], onDelete: Cascade)

  @@unique([websiteId, apiEndpointId, tier]) // + NULLS NOT DISTINCT variant in sql/030
  @@index([status, nextRunAt])
  @@map("monitoring_schedules")
}

/// Every scheduled/manual run. UNIQUE(schedule_id, slot, started_partition) gives exactly-once recording. [PARTITIONED daily on queued_at]
model MonitoringExecution {
  id                String          @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  queuedAt          DateTime        @default(now()) @map("queued_at") @db.Timestamptz(6)
  orgId             String          @map("org_id") @db.Uuid
  websiteId         String          @map("website_id") @db.Uuid
  scheduleId        String?         @map("schedule_id") @db.Uuid // NULL for manual runs
  slot              BigInt? // floor(epoch / interval)
  apiEndpointId     String?         @map("api_endpoint_id") @db.Uuid
  tier              CheckTier
  trigger           String          @default("SCHEDULE") // SCHEDULE | MANUAL | VERIFY | RECOVERY_CHECK
  region            String          @default("r1")
  status            ExecutionStatus @default(QUEUED)
  attempt           Int             @default(1)
  workerId          String?         @map("worker_id")
  startedAt         DateTime?       @map("started_at") @db.Timestamptz(6)
  finishedAt        DateTime?       @map("finished_at") @db.Timestamptz(6)
  durationMs        Int?            @map("duration_ms")
  configVersion     Int?            @map("config_version")
  suppressAlerts    Boolean         @default(false) @map("suppress_alerts") // maintenance window
  summary           Json? // {pages, passed, failed, signals}
  errorCode         String?         @map("error_code") // infra error, not target error
  errorMessage      String?         @map("error_message")
  enqueuedAt        DateTime?       @map("enqueued_at") @db.Timestamptz(6)
  leaseExpiresAt    DateTime?       @map("lease_expires_at") @db.Timestamptz(6) // RUNNING lease (crash detection)
  failureCategory   String?         @map("failure_category") // TRANSIENT | PERMANENT | SECURITY | TIMEOUT | INELIGIBLE | CANCELLED
  cancelRequestedAt DateTime?       @map("cancel_requested_at") @db.Timestamptz(6)

  @@id([id, queuedAt])
  @@unique([scheduleId, slot, queuedAt]) // effective dedupe is per-day partition; scheduler also dedupes via jobId
  @@index([orgId, websiteId, queuedAt(sort: Desc)])
  @@index([status, queuedAt])
  @@index([orgId, status])
  @@map("monitoring_executions")
}

