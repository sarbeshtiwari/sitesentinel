/// T1 HTTP probes and SSL checks.
model CheckResult {
  id              String       @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  checkedAt       DateTime     @map("checked_at") @db.Timestamptz(6)
  orgId           String       @map("org_id") @db.Uuid
  websiteId       String       @map("website_id") @db.Uuid
  executionId     String       @map("execution_id") @db.Uuid
  url             String
  status          ResultStatus
  failureKind     String?      @map("failure_kind") // DNS_FAIL | TIMEOUT | TLS | HTTP_5XX | ...
  httpStatus      Int?         @map("http_status")
  redirectChain   Json?        @map("redirect_chain")
  dnsMs           Int?         @map("dns_ms")
  connectMs       Int?         @map("connect_ms")
  tlsMs           Int?         @map("tls_ms")
  ttfbMs          Int?         @map("ttfb_ms")
  totalMs         Int?         @map("total_ms")
  bytes           Int?
  resolvedIp      String?      @map("resolved_ip") @db.Inet
  sslExpiresAt    DateTime?    @map("ssl_expires_at") @db.Timestamptz(6)
  sslIssuer       String?      @map("ssl_issuer")
  sslValid        Boolean?     @map("ssl_valid")
  confirmed       Boolean      @default(false) // failure confirmed by retry / second region
  region          String       @default("r1")
  // Phase 4C: checked_at = the execution's scheduled window start (deterministic → idempotent key)
  method          String? // GET | HEAD (after any HEAD→GET fallback)
  finalUrl        String?      @map("final_url") // sanitised: no query values, credentials or fragment
  contentType     String?      @map("content_type")
  responseHeaders Json?        @map("response_headers") // allow-listed, truncated
  failureCategory String?      @map("failure_category") // TARGET_TEMPORARY | TARGET_PERMANENT | GATEWAY_INFRASTRUCTURE | ...
  available       Boolean? // uptime verdict: up / down / NULL = excluded
  details         Json? // per-class verdicts, TLS facts, redirect hops' timings, truncation, HEAD fallback
  attempt         Int?
  startedAt       DateTime?    @map("started_at") @db.Timestamptz(6)
  finishedAt      DateTime?    @map("finished_at") @db.Timestamptz(6)

  @@id([id, checkedAt])
  @@unique([executionId, checkedAt]) // one logical result per execution, however often it runs
  @@index([websiteId, checkedAt(sort: Desc)])
  @@map("check_results")
}

