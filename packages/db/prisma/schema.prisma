// =============================================================================
// @wim/db — Prisma schema (Phase 1 proposal)
//
// Conventions
//  - PostgreSQL 16. All ids are UUIDv7-compatible uuid (generated in app via
//    `uuidv7()` for index locality; DB default gen_random_uuid() as fallback).
//  - Every tenant-scoped table carries `org_id` and is protected by RLS
//    (see ../sql/020_rls.sql).
//  - Tables marked [PARTITIONED] are created as RANGE-partitioned tables by
//    ../sql/010_partitions.sql. Their PK includes the partition key. Other tables
//    reference them by plain uuid columns WITHOUT foreign keys (by design:
//    partitions are dropped wholesale by retention).
//  - Partial unique indexes, CHECK constraints, triggers and grants that Prisma
//    cannot express live in ../sql/*.sql and are listed in DATABASE_SCHEMA.md.
//  - Columns suffixed `_enc` hold envelope-encrypted ciphertext (packages/crypto).
//  - Columns suffixed `_hash` hold SHA-256 (tokens) or keyed HMAC (signals).
// =============================================================================

generator client {
  provider            = "prisma-client"
  output              = "../src/generated"
  moduleFormat        = "esm"
  importFileExtension = "js"
  runtime             = "nodejs"
}

datasource db {
  provider = "postgresql"
}

