  editedAt   DateTime? @map("edited_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
  @@map("incident_comments")
}

/// Transactional outbox: written in the same tx as domain changes, relayed to Redis Streams.
model OutboxEvent {
  id          BigInt    @id @default(autoincrement())
  orgId       String?   @map("org_id") @db.Uuid
  topic       String // incident.created, website.verified, subscription.changed, ...
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  attempts    Int       @default(0)
  dedupeKey   String?   @unique @map("dedupe_key") // Phase 4C: one event per logical occurrence

  @@index([publishedAt, id])
  @@map("outbox_events")
}

// ----------------------------------------------------------------------------
// Notifications
// ----------------------------------------------------------------------------

model Notification {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId      String    @map("org_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  type       String // INCIDENT_CREATED | INCIDENT_RESOLVED | SSL_EXPIRING | BILLING_FAILED | ...
  severity   Severity?
  title      String
  body       String
  link       String?
  incidentId String?   @map("incident_id") @db.Uuid
  readAt     DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, orgId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

model NotificationPreference {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId            String      @map("org_id") @db.Uuid
  userId           String      @map("user_id") @db.Uuid
  channel          ChannelKind
  minSeverity      Severity    @default(MEDIUM) @map("min_severity")
  eventTypes       String[]    @default([]) @map("event_types") // empty = all
  websiteIds       String[]    @default([]) @map("website_ids") @db.Uuid // empty = all
  digest           String      @default("IMMEDIATE") // IMMEDIATE | HOURLY | DAILY
  quietHours       Json?       @map("quiet_hours") // {start:"22:00", end:"07:00", tz, exceptCritical:true}
  enabled          Boolean     @default(true) // Phase 4F: channel switched off by the user
  soundEnabled     Boolean     @default(true) @map("sound_enabled")
  soundMinSeverity Severity    @default(HIGH) @map("sound_min_severity")
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId, channel])
  @@map("notification_preferences")
}

/// Org-level delivery targets beyond members (extra email recipients, future Slack/Teams/etc).
model NotificationChannel {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String      @map("org_id") @db.Uuid
  kind        ChannelKind
  name        String
  target      String? // e.g. email address (non-secret)
  configEnc   Bytes?      @map("config_enc") // webhook URLs / tokens
  keyVersion  Int?        @map("key_version")
  minSeverity Severity    @default(HIGH) @map("min_severity")
  verifiedAt  DateTime?   @map("verified_at") @db.Timestamptz(6) // email recipients confirm opt-in
  enabled     Boolean     @default(true)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, kind])
  @@map("notification_channels")
}

/// [PARTITIONED monthly on created_at]
model NotificationDeliveryLog {
  id                String         @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  orgId             String?        @map("org_id") @db.Uuid
  channel           ChannelKind
  recipientRef      String         @map("recipient_ref") // user id or channel id, never raw address
  eventType         String         @map("event_type")
  incidentId        String?        @map("incident_id") @db.Uuid
  idempotencyKey    String         @map("idempotency_key")
  status            DeliveryStatus
  attempts          Int            @default(0)
  providerMessageId String?        @map("provider_message_id")
  lastError         String?        @map("last_error")
  sentAt            DateTime?      @map("sent_at") @db.Timestamptz(6)

  @@id([id, createdAt])
  @@index([orgId, createdAt(sort: Desc)])
  @@index([idempotencyKey])
  @@map("notification_delivery_logs")
}

model EmailSuppression {
  emailHash String   @id @map("email_hash") // HMAC
  reason    String // BOUNCE | COMPLAINT | MANUAL
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("email_suppressions")
}

model EmailTemplate {
  key         String   @id // incident.created, billing.failed, ...
  subject     String
  bodyMjml    String?  @map("body_mjml") // admin override; NULL = built-in React Email template
  enabled     Boolean  @default(true)
  version     Int      @default(1)
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("email_templates")
}

// ----------------------------------------------------------------------------
// Billing
// ----------------------------------------------------------------------------

model SubscriptionPlan {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key           String    @unique // starter, professional, business
  name          String
  description   String
  visible       Boolean   @default(true)
  active        Boolean   @default(true)
  trialEligible Boolean   @default(true) @map("trial_eligible")
  priority      Int       @default(5) // scheduler priority
  sortOrder     Int       @default(0) @map("sort_order")
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  prices       PlanPrice[]
  entitlements PlanEntitlement[]

  @@map("subscription_plans")
}

/// Immutable price versions (gateway prices are immutable).
model PlanPrice {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId         String          @map("plan_id") @db.Uuid
  interval       BillingInterval
  currency       String          @db.Char(3)
  amountMinor    Int             @map("amount_minor") // cents / paise
  version        Int
  active         Boolean         @default(true)
  stripePriceId  String?         @unique @map("stripe_price_id")
  razorpayPlanId String?         @unique @map("razorpay_plan_id")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  plan          SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  subscriptions Subscription[]

  @@unique([planId, interval, currency, version])
  @@map("plan_prices")
}

model PlanEntitlement {
  planId String @map("plan_id") @db.Uuid
  key    String // registry key, e.g. "websites.max"
  value  Json

  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([planId, key])
  @@map("plan_entitlements")
}

/// Admin-set per-org overrides (the spec's `subscription_entitlements`).
model EntitlementOverride {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String    @map("org_id") @db.Uuid
  key         String
  value       Json
  reason      String
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, key])
  @@map("entitlement_overrides")
}

model Subscription {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                 String             @map("org_id") @db.Uuid
  planPriceId           String?            @map("plan_price_id") @db.Uuid // NULL while trialing w/o price
  planId                String             @map("plan_id") @db.Uuid
  gateway               GatewayKind?
  gatewaySubscriptionId String?            @unique @map("gateway_subscription_id")
  status                SubscriptionStatus
  currentPeriodStart    DateTime?          @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd      DateTime?          @map("current_period_end") @db.Timestamptz(6)
  cancelAtPeriodEnd     Boolean            @default(false) @map("cancel_at_period_end")
  canceledAt            DateTime?          @map("canceled_at") @db.Timestamptz(6)
  graceEndsAt           DateTime?          @map("grace_ends_at") @db.Timestamptz(6)
  pendingPlanPriceId    String?            @map("pending_plan_price_id") @db.Uuid // scheduled downgrade
  gatewayUpdatedAt      DateTime?          @map("gateway_updated_at") @db.Timestamptz(6) // out-of-order guard
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  planPrice    PlanPrice?   @relation(fields: [planPriceId], references: [id], onDelete: Restrict)

  // + partial unique: one current subscription per org WHERE status NOT IN ('CANCELED','EXPIRED') (sql/030)
  @@index([orgId, status])
  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

model Trial {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId             String      @map("org_id") @db.Uuid
  planId            String?     @map("plan_id") @db.Uuid // assigned once plans exist (Phase 8; setting trial.planKey)
  registrableDomain String      @map("registrable_domain") // the domain whose verification activated it
  status            TrialStatus @default(ACTIVE)
  startsAt          DateTime    @map("starts_at") @db.Timestamptz(6)
  endsAt            DateTime    @map("ends_at") @db.Timestamptz(6)
  extendedDays      Int         @default(0) @map("extended_days")
  extendedById      String?     @map("extended_by_id") @db.Uuid
  riskScore         Int?        @map("risk_score")
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId]) // one trial per org, ever
  @@index([status, endsAt])
  @@map("trials")
}

model GatewayCustomer {
  id                   String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                String      @map("org_id") @db.Uuid
  gateway              GatewayKind
  gatewayCustomerId    String      @map("gateway_customer_id")
  defaultPaymentMethod Json?       @map("default_payment_method") // {brand, last4, expMonth, expYear} only
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, gateway])
  @@unique([gateway, gatewayCustomerId])
  @@map("gateway_customers")
}

model Payment {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId            String        @map("org_id") @db.Uuid
  subscriptionId   String?       @map("subscription_id") @db.Uuid
  invoiceId        String?       @map("invoice_id") @db.Uuid
  gateway          GatewayKind
  gatewayPaymentId String        @map("gateway_payment_id")
  amountMinor      Int           @map("amount_minor")
  currency         String        @db.Char(3)
  status           PaymentStatus
  failureCode      String?       @map("failure_code")
  failureMessage   String?       @map("failure_message")
  refundedMinor    Int           @default(0) @map("refunded_minor")
  paidAt           DateTime?     @map("paid_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([gateway, gatewayPaymentId])
  @@index([orgId, createdAt(sort: Desc)])
  @@map("payments")
}

model Invoice {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId            String        @map("org_id") @db.Uuid
  subscriptionId   String?       @map("subscription_id") @db.Uuid
  number           String        @unique // sequential, gapless per series (sql/030 sequence)
  gateway          GatewayKind?
  gatewayInvoiceId String?       @map("gateway_invoice_id")
  status           InvoiceStatus
  currency         String        @db.Char(3)
  subtotalMinor    Int           @map("subtotal_minor")
  taxMinor         Int           @default(0) @map("tax_minor")
  totalMinor       Int           @map("total_minor")
  taxDetails       Json?         @map("tax_details")
  billingDetails   Json?         @map("billing_details") // snapshot required for tax compliance
  periodStart      DateTime?     @map("period_start") @db.Timestamptz(6)
  periodEnd        DateTime?     @map("period_end") @db.Timestamptz(6)
  pdfArtifactId    String?       @map("pdf_artifact_id") @db.Uuid
  issuedAt         DateTime      @map("issued_at") @db.Timestamptz(6)
  paidAt           DateTime?     @map("paid_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict) // legal retention

  @@index([orgId, issuedAt(sort: Desc)])
  @@map("invoices")
}

model PaymentWebhookEvent {
  id             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gateway        GatewayKind
  eventId        String                  @map("event_id")
  eventType      String                  @map("event_type")
  signatureValid Boolean                 @map("signature_valid")
  payload        Json // verified payload; card data never present (gateway-tokenized)
  status         WebhookProcessingStatus @default(RECEIVED)
  attempts       Int                     @default(0)
  error          String?
  receivedAt     DateTime                @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt    DateTime?               @map("processed_at") @db.Timestamptz(6)

  @@unique([gateway, eventId])
  @@index([status, receivedAt])
  @@map("payment_webhook_events")
}

model PaymentGatewayConfig {
  gateway     GatewayKind @id
  enabled     Boolean     @default(false)
  mode        String      @default("test") // test | live
  publicKey   String?     @map("public_key")
  secretsEnc  Bytes?      @map("secrets_enc") // secret key + webhook secret, platform DEK
  keyVersion  Int?        @map("key_version")
  secretHint  String?     @map("secret_hint")
  currencies  String[]    @default([])
  settings    Json        @default("{}") // tax mode, statement descriptor, …
  updatedById String?     @map("updated_by_id") @db.Uuid
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("payment_gateway_configs")
}

/// Metered usage per period (browser minutes, SDK events, executions).
model UsageCounter {
  orgId       String   @map("org_id") @db.Uuid
  periodStart DateTime @map("period_start") @db.Date
  key         String // browser.minutes, sdk.events, executions.t1, ...
  value       BigInt   @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([orgId, periodStart, key])
  @@map("usage_counters")
}

// ----------------------------------------------------------------------------
// Audit, security, platform configuration, operations
// ----------------------------------------------------------------------------

/// Append-only, hash-chained per stream. App roles have INSERT/SELECT only; trigger rejects UPDATE/DELETE (sql/040).
model AuditLog {
  id         BigInt    @id @default(autoincrement())
  stream     String // "platform" | "org:{orgId}"
  seq        BigInt    @default(0) // per-stream sequence — assigned by trigger (sql/040)
  occurredAt DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  orgId      String?   @map("org_id") @db.Uuid
  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id") @db.Uuid
  actorLabel String?   @map("actor_label") // masked display
  action     String // e.g. website.create, plan.update, breakglass.access
  targetType String?   @map("target_type")
  targetId   String?   @map("target_id")
  ipPrefix   String?   @map("ip_prefix")
  requestId  String?   @map("request_id")
  changes    Json? // redacted before/after diff
  reason     String?
  prevHash   String    @default("") @map("prev_hash") // assigned by trigger
  hash       String    @default("") // sha256(prev_hash || canonical row) — assigned by trigger

  @@unique([stream, seq])
  @@index([orgId, occurredAt(sort: Desc)])
  @@index([action, occurredAt])
  @@map("audit_logs")
}

model AuditAnchor {
  id         BigInt   @id @default(autoincrement())
  stream     String
  seq        BigInt
  hash       String
  exportedTo String   @map("exported_to") // object-lock storage key
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([stream, seq])
  @@map("audit_anchors")
}

/// [PARTITIONED monthly]
model SecurityEvent {
  id         String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  kind       String // SSRF_BLOCKED | WEBHOOK_SIG_INVALID | RATE_LIMITED | IDOR_PROBE | MFA_FAILED | SUSPICIOUS_SIGNUP ...
  severity   Severity
  orgId      String?  @map("org_id") @db.Uuid
  actorRef   String?  @map("actor_ref")
  ipPrefix   String?  @map("ip_prefix")
  details    Json

  @@id([id, occurredAt])
  @@index([kind, occurredAt])
  @@map("security_events")
}

model BreakGlassRequest {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                String           @map("org_id") @db.Uuid
  requestedById        String           @map("requested_by_id") @db.Uuid
  approvedById         String?          @map("approved_by_id") @db.Uuid // must differ from requester (CHECK)
  customerApprovedById String?          @map("customer_approved_by_id") @db.Uuid
  purpose              String
  ticketRef            String           @map("ticket_ref")
  scope                String[] // e.g. ["incident_details","screenshots"]
  status               BreakGlassStatus @default(REQUESTED)
  durationMin          Int              @map("duration_min")
  activatedAt          DateTime?        @map("activated_at") @db.Timestamptz(6)
  expiresAt            DateTime?        @map("expires_at") @db.Timestamptz(6)
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([orgId, status])
  @@map("break_glass_requests")
}

model PlatformSetting {
  key         String       @id
  scope       SettingScope @default(PLATFORM)
  value       Json // secrets stored as {enc: base64} with platform DEK
  version     Int          @default(1)
  updatedById String?      @map("updated_by_id") @db.Uuid
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  history PlatformSettingHistory[]

  @@map("platform_settings")
}

model PlatformSettingHistory {
  id          BigInt   @id @default(autoincrement())
  key         String
  version     Int
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  setting PlatformSetting @relation(fields: [key], references: [key], onDelete: Cascade)

  @@unique([key, version])
  @@map("platform_setting_history")
}

model FeatureFlag {
  key          String   @id
  description  String
  enabled      Boolean  @default(false)
  rolloutPct   Int      @default(0) @map("rollout_pct")
  orgAllowlist String[] @default([]) @map("org_allowlist") @db.Uuid
  planKeys     String[] @default([]) @map("plan_keys")
  updatedById  String?  @map("updated_by_id") @db.Uuid
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("feature_flags")
}

model WorkerHeartbeat {
  workerId   String    @id @map("worker_id")
  kind       String // http | browser | incident | notify | maintenance | billing | scheduler
  region     String
  version    String
  hostname   String
  startedAt  DateTime  @map("started_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @map("last_seen_at") @db.Timestamptz(6)
  activeJobs Int       @map("active_jobs")
  capacity   Int
  rssMb      Int?      @map("rss_mb")
  isLeader   Boolean   @default(false) @map("is_leader")
  /// Phase 4H: work actually done since start (alive ≠ processing), failures, timeouts, last job end
  processed  Int       @default(0)
  failed     Int       @default(0)
  timeouts   Int       @default(0)
  lastJobAt  DateTime? @map("last_job_at") @db.Timestamptz(6)
  /// Phase 4H: dependency probes {redis|gateway|runner|storage|smtp: {ok, ms, at, error?}} and extra gauges (runner sessions …).
  /// Never URLs, credentials or customer data.
  deps       Json?
  meta       Json?

  @@index([kind, lastSeenAt])
  @@map("worker_heartbeats")
}

/// Phase 4H: latest evaluated state per platform component (written by the health evaluator, read by Super Admin).
/// Aggregate operational data only — never tenant identifiers, URLs or customer content.
model PlatformHealth {
  component   String   @id
  state       String // HEALTHY | DEGRADED | UNHEALTHY | UNKNOWN
  reasons     Json     @default("[]")
  metrics     Json     @default("{}")
  since       DateTime @db.Timestamptz(6) /// when the current state began
  evaluatedAt DateTime @map("evaluated_at") @db.Timestamptz(6)
  evaluatedBy String   @map("evaluated_by")

  @@map("platform_health")
}

/// Phase 4H: platform self-alerts (separate from customer incidents). One open alert per fingerprint.
model PlatformAlert {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fingerprint      String
  rule             String
  component        String
  severity         String // CRITICAL | WARNING | INFO
  state            String // OPEN | ACKNOWLEDGED | RECOVERED
  reason           String
  details          Json      @default("{}")
  openedAt         DateTime  @default(now()) @map("opened_at") @db.Timestamptz(6)
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  occurrences      Int       @default(1)
  reopenCount      Int       @default(0) @map("reopen_count")
  acknowledgedAt   DateTime? @map("acknowledged_at") @db.Timestamptz(6)
  acknowledgedById String?   @map("acknowledged_by_id") @db.Uuid
  recoveredAt      DateTime? @map("recovered_at") @db.Timestamptz(6)
  /// set when a failing shared dependency explains this alert: recorded, not notified
  suppressedBy     String?   @map("suppressed_by") @db.Uuid
  lastNotifiedAt   DateTime? @map("last_notified_at") @db.Timestamptz(6)
  notifyState      String    @default("PENDING") @map("notify_state") // PENDING | QUEUED | SENT | FAILED | SUPPRESSED | NONE

  events PlatformAlertEvent[]

  @@index([state, openedAt])
  @@index([fingerprint, openedAt])
  @@map("platform_alerts")
}

model PlatformAlertEvent {
  id      BigInt   @id @default(autoincrement())
  alertId String   @map("alert_id") @db.Uuid
  at      DateTime @default(now()) @db.Timestamptz(6)
  type    String // OPENED | REOPENED | ESCALATED | RECOVERED | ACKNOWLEDGED | NOTIFY_QUEUED | NOTIFY_SENT | NOTIFY_FAILED | NOTIFY_SUPPRESSED | SUPPRESSED
  actorId String?  @map("actor_id") @db.Uuid
  details Json     @default("{}")

  alert PlatformAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId, at])
  @@map("platform_alert_events")
}

/// Phase 4H: usage reconciliation runs (requested by an operator or the daily job) and the discrepancies found.
model UsageReconciliationRun {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  day           DateTime  @db.Date
  status        String // REQUESTED | RUNNING | DONE | FAILED
  requestedById String?   @map("requested_by_id") @db.Uuid
  requestedAt   DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  startedAt     DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz(6)
  stats         Json?
  error         String?

  discrepancies UsageDiscrepancy[]

  @@index([day, requestedAt])
  @@map("usage_reconciliation_runs")
}

model UsageDiscrepancy {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId        String    @map("run_id") @db.Uuid
  orgId        String    @map("org_id") @db.Uuid
  day          DateTime  @db.Date
  check        String // e.g. "http.checks~ledger"
  key          String? // usage key the check compares (null for result-integrity checks)
  recorded     BigInt
  expected     BigInt
  status       String    @default("OPEN") // OPEN | ADJUSTED | ACCEPTED
  resolvedById String?   @map("resolved_by_id") @db.Uuid
  resolvedAt   DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolution   String?

  run UsageReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, orgId, check], map: "usage_discrepancies_unique")
  @@index([runId])
  @@index([orgId, day])
  @@map("usage_discrepancies")
}

/// Phase 4H: every manual change to usage counters, with reason and actor (applied atomically with the counter).
model UsageAdjustment {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  day           DateTime @db.Date
  key           String
  delta         BigInt
  reason        String
  actorId       String   @map("actor_id") @db.Uuid
  discrepancyId String?  @map("discrepancy_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([orgId, day])
  @@map("usage_adjustments")
}

/// [PARTITIONED monthly] Platform self-monitoring samples (queue depth, scheduler lag, …).
model SystemHealthLog {
  id         String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)
  component  String
  metric     String
  value      Float
  labels     Json?

  @@id([id, recordedAt])
  @@index([component, metric, recordedAt])
  @@map("system_health_logs")
}

/// Dead-letter ledger.
model JobFailure {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  queue               String
  jobId               String    @map("job_id")
  orgId               String?   @map("org_id") @db.Uuid
  payload             Json // already redacted (no secrets ever in payloads)
  error               String
  attempts            Int
  failedAt            DateTime  @default(now()) @map("failed_at") @db.Timestamptz(6)
  resolution          String? // REPLAYED | REPLAY_REFUSED | DISCARDED
  resolvedAt          DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolvedById        String?   @map("resolved_by_id") @db.Uuid
  executionId         String?   @map("execution_id") @db.Uuid
  websiteId           String?   @map("website_id") @db.Uuid
  jobType             String?   @map("job_type")
  failureCategory     String?   @map("failure_category")
  replayRequestedAt   DateTime? @map("replay_requested_at") @db.Timestamptz(6)
  replayRequestedById String?   @map("replay_requested_by_id") @db.Uuid
  replayReason        String?   @map("replay_reason")
  replayExecutionId   String?   @map("replay_execution_id") @db.Uuid

  @@index([queue, failedAt])
  @@index([resolvedAt])
  @@map("job_failures")
}

model ReportJob {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String       @map("org_id") @db.Uuid
  requestedById String       @map("requested_by_id") @db.Uuid
  kind          String // WEBSITE_HEALTH | UPTIME | API_HEALTH | INCIDENTS | PERFORMANCE | MONTHLY_SUMMARY
  format        ReportFormat
  params        Json // {websiteIds, from, to} — clamped to retention
  state         JobState     @default(QUEUED)
  artifactId    String?      @map("artifact_id") @db.Uuid
  error         String?
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt   DateTime?    @map("completed_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt(sort: Desc)])
  @@map("report_jobs")
}

/// Account/org data export and deletion workflows (GDPR-style).
model DataRequest {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind         String // EXPORT | DELETE_ORG | DELETE_USER
  orgId        String?   @map("org_id") @db.Uuid
  userId       String?   @map("user_id") @db.Uuid
  state        JobState  @default(QUEUED)
  scheduledFor DateTime? @map("scheduled_for") @db.Timestamptz(6) // deletion grace end
  artifactId   String?   @map("artifact_id") @db.Uuid
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(6)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([state, scheduledFor])
  @@map("data_requests")
}

/// Phase 4D: one logical result per execution, across ALL engines and partitions (non-partitioned,
/// so the execution id alone is unique). Result rows must reference a ledger row (trigger, sql/100).
model ExecutionResult {
  executionId String    @id @map("execution_id") @db.Uuid
  orgId       String    @map("org_id") @db.Uuid
  websiteId   String    @map("website_id") @db.Uuid
  tier        CheckTier
  windowStart DateTime  @map("window_start") @db.Timestamptz(6)
  outcome     String // PASSED | FAILED | INCONCLUSIVE
  attempt     Int
  recordedAt  DateTime  @default(now()) @map("recorded_at") @db.Timestamptz(6)

  @@index([websiteId, tier, windowStart(sort: Desc)])
  @@index([recordedAt])
  @@index([orgId, windowStart(sort: Desc)]) // Phase 4F: org-wide history
  @@index([orgId, recordedAt]) // Phase 4F: change feed
  @@map("execution_results")
}

/// Phase 4E: one deep scan per execution — progress, coverage and the config snapshot. A crash resumes from here.
model DeepScan {
  executionId         String    @id @map("execution_id") @db.Uuid
  orgId               String    @map("org_id") @db.Uuid
  websiteId           String    @map("website_id") @db.Uuid
  trigger             String    @default("SCHEDULE") // SCHEDULE | MANUAL | REPLAY
  status              String    @default("RUNNING") // RUNNING | COMPLETED | PARTIAL | CANCELLED | INCONCLUSIVE
  complete            Boolean   @default(false) // every discovered in-scope page within limits was checked
  stopReason          String?   @map("stop_reason") // FRONTIER_EXHAUSTED | PAGE_LIMIT | DURATION | REQUEST_BUDGET | DAILY_QUOTA | CANCELLED | INFRASTRUCTURE
  config              Json // effective limits + scope snapshot (resume uses the same)
  discovery           Json? // robots + sitemap summary; NULL until discovery finished
  pagesDiscovered     Int       @default(0) @map("pages_discovered")
  pagesCompleted      Int       @default(0) @map("pages_completed")
  pagesFailed         Int       @default(0) @map("pages_failed")
  pagesSkipped        Int       @default(0) @map("pages_skipped") // policy: robots, unsafe, blocked destination, invalid
  pagesDropped        Int       @default(0) @map("pages_dropped") // coverage: not crawled because of page/depth/trap limits
  pagesInconclusive   Int       @default(0) @map("pages_inconclusive")
  resourcesChecked    Int       @default(0) @map("resources_checked")
  requests            Int       @default(0)
  bytes               BigInt    @default(0)
  browserMs           Int       @default(0) @map("browser_ms")
  findingsOpened      Int       @default(0) @map("findings_opened")
  findingsResolved    Int       @default(0) @map("findings_resolved")
  comparison          Json? // vs baseline (previous COMPLETED scan)
  baselineExecutionId String?   @map("baseline_execution_id") @db.Uuid
  startedAt           DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  finishedAt          DateTime? @map("finished_at") @db.Timestamptz(6)

  urls DeepScanUrl[]

  @@index([websiteId, startedAt(sort: Desc)])
  @@index([orgId, status])
  @@index([orgId, updatedAt]) // Phase 4F: change feed
  @@map("deep_scans")
}

/// Phase 4E: the resumable frontier and per-URL facts of one scan. url is normalised (tracking/sensitive params removed).
model DeepScanUrl {
  id            BigInt    @id @default(autoincrement())
  executionId   String    @map("execution_id") @db.Uuid
  orgId         String    @map("org_id") @db.Uuid
  websiteId     String    @map("website_id") @db.Uuid
  urlHash       String    @map("url_hash")
  url           String
  kind          String // PAGE | RESOURCE | EXTERNAL | SITEMAP
  resourceType  String?   @map("resource_type") // image | stylesheet | script | font | other
  state         String    @default("QUEUED") // QUEUED | DONE | FAILED | SKIPPED | INCONCLUSIVE
  skipReason    String?   @map("skip_reason")
  depth         Int       @default(0)
  source        String // START | SITEMAP | CRAWL | BROWSER
  inSitemap     Boolean   @default(false) @map("in_sitemap")
  referrers     Int       @default(0) // pages linking here (bounded count)
  firstReferrer String?   @map("first_referrer") // display form
  statusCode    Int?      @map("status_code")
  finalUrl      String?   @map("final_url") // display form
  redirectChain Json?     @map("redirect_chain")
  contentType   String?   @map("content_type")
  bytes         Int?
  durationMs    Int?      @map("duration_ms")
  facts         Json? // title, description, canonical, robots, lang, h1s, headings, og, json-ld, a11y counts, hashes
  error         String?
  checkedAt     DateTime? @map("checked_at") @db.Timestamptz(6)

  scan DeepScan @relation(fields: [executionId], references: [executionId], onDelete: Cascade)

  @@unique([executionId, urlHash])
  @@index([executionId, state, kind, depth])
  @@map("deep_scan_urls")
}

/// Phase 4E: a finding = one problem on one subject (page/resource/sitemap/site), grouped across scans.
model ScanFinding {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId               String    @map("org_id") @db.Uuid
  websiteId           String    @map("website_id") @db.Uuid
  fingerprint         String // category + subject (stable across scans)
  category            String
  groupKey            String    @map("group_key") // broken_pages | broken_resources | sitemap | seo | accessibility | structure
  severity            String
  status              String    @default("OPEN") // OPEN | RESOLVED
  subject             String // display URL or "site"
  title               String
  evidence            Json
  recommendation      String
  detectionMethod     String    @map("detection_method")
  confirmed           Boolean   @default(true)
  occurrenceCount     Int       @default(1) @map("occurrence_count")
  reopenCount         Int       @default(0) @map("reopen_count")
  firstDetectedAt     DateTime  @map("first_detected_at") @db.Timestamptz(6)
  lastDetectedAt      DateTime  @map("last_detected_at") @db.Timestamptz(6)
  resolvedAt          DateTime? @map("resolved_at") @db.Timestamptz(6)
  firstExecutionId    String    @map("first_execution_id") @db.Uuid
  lastExecutionId     String    @map("last_execution_id") @db.Uuid
  resolvedExecutionId String?   @map("resolved_execution_id") @db.Uuid

  @@unique([websiteId, fingerprint])
  @@index([orgId, websiteId, status, severity])
  @@map("scan_findings")
}

model ScanFindingEvent {
  id          BigInt   @id @default(autoincrement())
  orgId       String   @map("org_id") @db.Uuid
  findingId   String   @map("finding_id") @db.Uuid
  executionId String   @map("execution_id") @db.Uuid
  type        String // OPENED | RECURRED | RESOLVED | REOPENED
  data        Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([findingId, executionId, type])
  @@index([findingId, createdAt])
  @@map("scan_finding_events")
}
