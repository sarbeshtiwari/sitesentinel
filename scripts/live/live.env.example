# Copy to ~/.sitesentinel/live.env and `chmod 600` it. Never commit the filled-in file.
# Database: EXTERNAL host of the hosted Postgres, with sslmode=require (each role's own password).
WORKER_DATABASE_URL=postgresql://wim_worker:CHANGE_ME@<host>.virginia-postgres.render.com/sitesentinel_db?sslmode=require
SCANNER_DATABASE_URL=postgresql://wim_scanner:CHANGE_ME@<host>.virginia-postgres.render.com/sitesentinel_db?sslmode=require
# Redis: the EXTERNAL rediss:// URL (and allow this machine's IP in the Key Value inbound rules)
REDIS_URL=rediss://red-xxxx:CHANGE_ME@virginia-keyvalue.render.com:6379
# One random value shared by the gateway and the workers: openssl rand -hex 32
EGRESS_TOKEN_SECRET=
# Same value as KEK_RING_JSON on the API service
KEK_RING_JSON=
# Public URLs used in notification links
APP_URL=https://sitesentinel-web.onrender.com
ADMIN_URL=https://sitesentinel-admin.onrender.com
# Platform alert recipients while the database is unreachable (comma-separated)
OPS_FALLBACK_ALERT_EMAILS=you@example.com
# Email (in-app notifications work without it): resend | smtp | ses
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM_DOMAIN=example.com
