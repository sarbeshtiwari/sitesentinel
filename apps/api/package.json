{
  "name": "@wim/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "swc src -d dist --strip-leading-paths --config-file .swcrc",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "swc src -d dist --strip-leading-paths --config-file .swcrc -w & node --enable-source-maps --watch-path=dist dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "test:integration": "vitest run --config vitest.config.ts",
    "test": "vitest run --config vitest.config.ts",
    "admin:create": "node --env-file-if-exists=../../.env --enable-source-maps dist/cli/create-admin.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-fastify": "12.5.0",
    "@wim/contracts": "workspace:*",
    "@wim/core": "workspace:*",
    "@wim/crypto": "workspace:*",
    "@wim/db": "workspace:*",
    "@wim/email": "workspace:*",
    "@wim/logger": "workspace:*",
    "bullmq": "6.7.6",
    "fastify": "5.12.8",
    "ioredis": "6.0.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7",
    "@wim/sdk": "workspace:*",
    "@wim/queue": "workspace:*",
    "@wim/storage": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/testing": "12.5.0",
    "@swc/cli": "0.8.2",
    "@swc/core": "1.16.22",
    "@types/node": "^24.0.0",
    "@types/qrcode": "1.5.6",
    "@wim/worker-notify": "workspace:*",
    "typescript": "5.9.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0",
    "pg": "8.23.1",
    "@types/pg": "^8.15.0",
    "@wim/worker-http": "workspace:*",
    "@wim/ingest": "workspace:*",
    "@wim/test-fixtures": "workspace:*",
    "@wim/netguard": "workspace:*",
    "@wim/egress-gateway": "workspace:*",
    "@wim/scheduler": "workspace:*",
    "@wim/browser-runner": "workspace:*",
    "@wim/worker-browser": "workspace:*",
    "@wim/storage": "workspace:*",
    "@wim/worker-deepscan": "workspace:*"
  }
}
