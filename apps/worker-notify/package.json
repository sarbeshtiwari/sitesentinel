{
  "name": "@wim/worker-notify",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json -w & node --enable-source-maps --watch-path=dist dist/main.js",
    "start": "node --enable-source-maps dist/main.js"
  },
  "dependencies": {
    "@wim/contracts": "workspace:*",
    "@wim/core": "workspace:*",
    "@wim/crypto": "workspace:*",
    "@wim/db": "workspace:*",
    "@wim/email": "workspace:*",
    "@wim/logger": "workspace:*",
    "@wim/queue": "workspace:*",
    "bullmq": "6.7.6",
    "ioredis": "6.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": { "typescript": "5.9.3", "@types/node": "^24.0.0" }
}
